{
  "manifest_version": 3,
  "name": "Oriental Insurance Automation",
  "version": "1.0.0",
  "description": "Automates login and form filling on Oriental Insurance website",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://orientalinsurance.org.in/*",
    "https://*.orientalinsurance.org.in/*",
    "https://otpservice.coverscrafter.com/*",
    "https://instapolicy.coverscrafter.com/*",
    "https://dealer.coverscrafter.com/*",
    "https://api.openai.com/*"
  ],
  "options_page": "config.html",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://orientalinsurance.org.in/*",
        "https://*.orientalinsurance.org.in/*"
      ],
      "js": ["flows/shared.js", "flows/form.js", "flows/kyc.js","content.js"],
      "run_at": "document_idle"
    }
  ]
}
