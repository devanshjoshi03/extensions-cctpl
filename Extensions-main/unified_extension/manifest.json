{
  "manifest_version": 3,
  "name": "CoversCrafter Insurance Automation",
  "version": "1.0.0",
  "description": "Unified automation for Bajaj, ICICI Lombard, Universal Sompo, and Oriental Insurance portals",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://portal.bajajgeneral.com/*",
    "https://*.bajajgeneral.com/*",
    "https://kyc.bajajallianz.com/*",
    "https://*.bajajallianz.com/*",
    "https://nysa.icicilombard.com/*",
    "https://*.icicilombard.com/*",
    "https://agencyforce.universalsompo.com/*",
    "https://*.universalsompo.com/*",
    "https://orientalinsurance.org.in/*",
    "https://*.orientalinsurance.org.in/*",
    "https://otpservice.coverscrafter.com/*",
    "https://instapolicy.coverscrafter.com/*",
    "https://dealer.coverscrafter.com/*",
    "https://api.openai.com/*"
  ],
  "options_page": "config.html",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.bajajgeneral.com/*",
        "https://*.bajajgeneral.com/*"
      ],
      "js": ["providers/bajaj/page-download-guard.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://portal.bajajgeneral.com/*",
        "https://*.bajajgeneral.com/*"
      ],
      "js": [
        "providers/bajaj/flows/shared.js",
        "providers/bajaj/flows/login.js",
        "providers/bajaj/flows/form.js",
        "providers/bajaj/flows/vehicledetails.js",
        "providers/bajaj/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://nysa.icicilombard.com/*",
        "https://*.icicilombard.com/*"
      ],
      "js": [
        "providers/icici/flows/shared.js",
        "providers/icici/flows/login.js",
        "providers/icici/flows/dashboard.js",
        "providers/icici/flows/quote.js",
        "providers/icici/flows/premium.js",
        "providers/icici/flows/proposal.js",
        "providers/icici/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://agencyforce.universalsompo.com/*",
        "https://*.universalsompo.com/*"
      ],
      "js": ["providers/sompo/page-download-guard.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://agencyforce.universalsompo.com/*",
        "https://*.universalsompo.com/*"
      ],
      "js": [
        "providers/sompo/flows/shared.js",
        "providers/sompo/flows/login.js",
        "providers/sompo/flows/QuoteDetails.js",
        "providers/sompo/flows/CoverDetails.js",
        "providers/sompo/flows/ProposalDetails.js",
        "providers/sompo/flows/Additional Details.js",
        "providers/sompo/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://orientalinsurance.org.in/*",
        "https://*.orientalinsurance.org.in/*"
      ],
      "js": ["providers/oriental/captcha-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://orientalinsurance.org.in/*",
        "https://*.orientalinsurance.org.in/*"
      ],
      "js": [
        "providers/oriental/flows/shared.js",
        "providers/oriental/flows/form.js",
        "providers/oriental/flows/kyc.js",
        "providers/oriental/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
