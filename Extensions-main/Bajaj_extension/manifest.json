{
  "manifest_version": 3,
  "name": "Bajaj General Insurance Automation",
  "version": "1.0.0",
  "description": "Automates form filling on Bajaj General Insurance portal",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://portal.bajajgeneral.com/*",
    "https://*.bajajgeneral.com/*",
    "https://kyc.bajajallianz.com/*",
    "https://*.bajajallianz.com/*",
    "https://otpservice.coverscrafter.com/*",
    "https://instapolicy.coverscrafter.com/*",
    "https://dealer.coverscrafter.com/*",
    "https://api.openai.com/*"
  ],
  "options_page": "config.html",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.bajajgeneral.com/*",
        "https://*.bajajgeneral.com/*"
      ],
      "js": ["page-download-guard.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://portal.bajajgeneral.com/*",
        "https://*.bajajgeneral.com/*"
      ],
      "js": ["flows/shared.js", "flows/login.js", "flows/form.js", "flows/vehicledetails.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
